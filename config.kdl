feature "vpn" enabled=true {
    state "off" {
        display-name "VPN выключен"
    }

    state "warp" {
        display-name "Warp"
        interface "w"
        up-cmd "echo" "VPN Warp Up"
        down-cmd "echo" "VPN Warp Down"
    }

    state "finland" {
        display-name "Финляндия"
        interface "fl"
        up-cmd "echo" "VPN Finland Up"
        down-cmd "echo" "VPN Finland Down"
    }
}

feature "daemons" enabled=true {
    daemon "picom" autostart=true {
        display-name "Picom Compositor"
        start-cmd "picom" "-b"
    }

    daemon "dunst" autostart=true {
        display-name "Dunst Notification Daemon"
        start-cmd "dunst"
    }
}

feature "actions" enabled=true {
    action "default-mode" export=true {
        vpn "finland"
        daemon "picom" "on"
    }

    action "game-mode" export=false {
        vpn "warp"
        daemon "picom" "off"
    }
}

feature "ipc" enabled=true {
    path "/tmp/de-configurator.sock"
}

feature "triggers" enabled=true {
    trigger "periodic-check" type="interval" {
        interval "1m"
        run "notify-send" "DE Configurator" "Periodic 1m check"
    }
}

feature "keybinds" enabled=true {
    bind "ctrl+shift+f9" {
        vpn "off"
    }

    bind "ctrl+shift+f10" {
        vpn "warp"
    }

    bind "ctrl+shift+f11" {
        vpn "finland"
    }

    bind "ctrl+shift+g" {
        action "game-mode"
    }

    bind "ctrl+shift+d" {
        action "default-mode"
    }
}
