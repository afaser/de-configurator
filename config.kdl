feature "vpn" enabled=true {
    state "off" {
        display-name "VPN выключен"
    }

    state "warp" {
        display-name "Warp"
        interface "w"
        up-cmd "echo" "VPN Warp Up"
        down-cmd "echo" "VPN Warp Down"
    }

    state "finland" {
        display-name "Финляндия"
        interface "fl"
        up-cmd "echo" "VPN Finland Up"
        down-cmd "echo" "VPN Finland Down"
    }
}

feature "daemons" enabled=true {
    daemon "picom" autostart=true {
        display-name "Picom Compositor"
        start-cmd "picom" "-b"
    }

    daemon "dunst" autostart=true {
        display-name "Dunst Notification Daemon"
        start-cmd "dunst"
    }
}

feature "actions" enabled=true {
    action "default-mode" export=true {
        vpn "finland"
        daemon "picom" "on"
    }

    action "game-mode" export=true {
        vpn "warp"
        daemon "picom" "off"
    }

    action "go-browser" export=true {
        workspace "browser"
    }

    action "go-telegram" export=true {
        workspace "telegram"
    }

    action "go-browser-vga" export=true {
        workspace "browser" "VGA-0"
    }

    action "go-browser-hdmi" export=true {
        workspace "browser" "HDMI-0"
    }
}

feature "ipc" enabled=true {
    path "/tmp/de-configurator.sock"
}

feature "triggers" enabled=true {
    trigger "periodic-check" type="interval" {
        interval "1m"
        run "notify-send" "DE Configurator" "Periodic 1m check"
    }

    trigger "on-desktop-change" type="wm" {
        event "desktop_focus"
        run "notify-send" "DE Configurator" "Desktop focused"
    }
}

feature "wm" enabled=true {}

feature "workspaces" enabled=true {
    workspace "browser" class="Brave-browser"
    workspace "telegram" class="AyuGramDesktop"
    workspace "discord" class="discord"
}

feature "keybinds" enabled=true {
    bind "ctrl+shift+f9" {
        vpn "off"
    }

    bind "ctrl+shift+f10" {
        vpn "warp"
    }

    bind "ctrl+shift+f11" {
        vpn "finland"
    }

    bind "ctrl+shift+g" {
        action "game-mode"
    }

    bind "ctrl+shift+d" {
        action "default-mode"
    }

    bind "ctrl+shift+b" {
        workspace "browser"
    }

    bind "ctrl+shift+t" {
        workspace "telegram"
    }

    bind "ctrl+shift+1" {
        workspace "browser" "VGA-0"
    }

    bind "ctrl+shift+2" {
        workspace "browser" "HDMI-0"
    }

    bind "alt+c" {
        run "alacritty"
    }

    bind "alt+e" {
        run "alacritty" "--class" "yazi_sticky,yazi_sticky" "--command" "yazi"
    }

    bind "alt+space" {
        run "rofi" "-show" "combi"
    }

    bind "alt+p" {
        run "flameshot" "gui"
    }

    bind "alt+v" {
        run "copyq" "show"
    }

    bind "super+escape" {
        run "pkill" "-USR1" "-x" "sxhkd"
    }

    bind "super+alt+q" {
        run "bspc" "quit"
    }

    bind "super+alt+r" {
        run "bspc" "wm" "-r"
    }

    bind "alt+w" {
        run "bspc" "node" "-c"
    }

    bind "alt+shift+w" {
        run "bspc" "node" "-k"
    }

    bind "alt+m" {
        run "bspc" "desktop" "-l" "next"
    }

    bind "alt+g" {
        run "bspc" "node" "-s" "biggest.window"
    }

    bind "alt+t" {
        run "bspc" "node" "-t" "tiled"
    }

    bind "alt+f" {
        run "bspc" "node" "-t" "floating"
    }

    bind "alt+shift+e" {
        run "bspc" "node" "-t" "fullscreen"
    }

    bind "alt+h" {
        run "bspc" "node" "-f" "west"
    }

    bind "alt+j" {
        run "bspc" "node" "-f" "south"
    }

    bind "alt+k" {
        run "bspc" "node" "-f" "north"
    }

    bind "alt+l" {
        run "bspc" "node" "-f" "east"
    }

    bind "alt+shift+h" {
        run "bspc" "node" "-s" "west"
    }

    bind "alt+shift+j" {
        run "bspc" "node" "-s" "south"
    }

    bind "alt+shift+k" {
        run "bspc" "node" "-s" "north"
    }

    bind "alt+shift+l" {
        run "bspc" "node" "-s" "east"
    }

    bind "super+p" {
        run "bspc" "node" "-f" "@parent"
    }

    bind "super+b" {
        run "bspc" "node" "-f" "@brother"
    }

    bind "super+comma" {
        run "bspc" "node" "-f" "@first"
    }

    bind "super+period" {
        run "bspc" "node" "-f" "@second"
    }

    bind "super+c" {
        run "bspc" "node" "-f" "next.local.!hidden.window"
    }

    bind "super+shift+c" {
        run "bspc" "node" "-f" "prev.local.!hidden.window"
    }

    bind "super+o" {
        run "sh" "-c" "bspc wm -h off; bspc node older -f; bspc wm -h on"
    }

    bind "super+i" {
        run "sh" "-c" "bspc wm -h off; bspc node newer -f; bspc wm -h on"
    }

    bind "alt+s" {
        run "bspc" "desktop" "-f" "s"
    }

    bind "alt+shift+s" {
        run "bspc" "node" "-d" "s"
    }

    bind "alt+y" {
        run "bspc" "desktop" "-f" "y"
    }

    bind "alt+shift+y" {
        run "bspc" "node" "-d" "y"
    }

    bind "alt+i" {
        run "bspc" "desktop" "-f" "i"
    }

    bind "alt+shift+i" {
        run "bspc" "node" "-d" "i"
    }

    bind "alt+o" {
        run "bspc" "desktop" "-f" "o"
    }

    bind "alt+shift+o" {
        run "bspc" "node" "-d" "o"
    }

    bind "alt+1" {
        run "bspc" "desktop" "-f" "1"
    }

    bind "alt+shift+1" {
        run "bspc" "node" "-d" "1"
    }

    bind "alt+2" {
        run "bspc" "desktop" "-f" "2"
    }

    bind "alt+shift+2" {
        run "bspc" "node" "-d" "2"
    }

    bind "alt+3" {
        run "bspc" "desktop" "-f" "3"
    }

    bind "alt+shift+3" {
        run "bspc" "node" "-d" "3"
    }

    bind "alt+4" {
        run "bspc" "desktop" "-f" "4"
    }

    bind "alt+shift+4" {
        run "bspc" "node" "-d" "4"
    }

    bind "alt+5" {
        run "bspc" "desktop" "-f" "5"
    }

    bind "alt+shift+5" {
        run "bspc" "node" "-d" "5"
    }

    bind "alt+6" {
        run "bspc" "desktop" "-f" "6"
    }

    bind "alt+shift+6" {
        run "bspc" "node" "-d" "6"
    }

    bind "alt+7" {
        run "bspc" "desktop" "-f" "7"
    }

    bind "alt+shift+7" {
        run "bspc" "node" "-d" "7"
    }

    bind "alt+8" {
        run "bspc" "desktop" "-f" "8"
    }

    bind "alt+shift+8" {
        run "bspc" "node" "-d" "8"
    }

    bind "alt+9" {
        run "bspc" "desktop" "-f" "9"
    }

    bind "alt+shift+9" {
        run "bspc" "node" "-d" "9"
    }

    bind "alt+0" {
        run "bspc" "desktop" "-f" "10"
    }

    bind "alt+shift+0" {
        run "bspc" "node" "-d" "10"
    }

    bind "alt+a" {
        workspace "telegram" "VGA-0"
    }

    bind "alt+shift+a" {
        workspace "telegram" "HDMI-0"
    }

    bind "alt+d" {
        workspace "discord" "VGA-0"
    }

    bind "alt+shift+d" {
        workspace "discord" "HDMI-0"
    }

    bind "alt+b" {
        workspace "browser" "HDMI-0"
    }

    bind "alt+shift+b" {
        workspace "browser" "VGA-0"
    }

    bind "alt+ctrl+h" {
        run "bspc" "node" "-p" "west"
    }

    bind "alt+ctrl+j" {
        run "bspc" "node" "-p" "south"
    }

    bind "alt+ctrl+k" {
        run "bspc" "node" "-p" "north"
    }

    bind "alt+ctrl+l" {
        run "bspc" "node" "-p" "east"
    }

    bind "alt+ctrl+space" {
        run "sh" "-c" "bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel"
    }

    bind "mediaplaypause" {
        run "playerctl" "--player=spotify" "play-pause"
    }

    bind "mediatracknext" {
        run "playerctl" "--player=spotify" "next"
    }

    bind "mediatrackprevious" {
        run "playerctl" "--player=spotify" "previous"
    }

    bind "audiovolumeup" {
        run "playerctl" "volume" "0.02+" "--player=spotify"
    }

    bind "audiovolumedown" {
        run "playerctl" "volume" "0.02-" "--player=spotify"
    }

    bind "audiovolumemute" {
        run "playerctl" "play-pause" "--player=spotify"
    }
}

