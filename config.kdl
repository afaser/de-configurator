// Конфигурационный файл для de-configurator

feature "vpn" enabled=true {
    state "off" {
        display-name "VPN выключен"
    }

    state "warp" {
        display-name "Warp"
        interface "w"
        up-cmd "doas" "wg-quick" "up" "w"
        down-cmd "doas" "wg-quick" "down" "w"
    }

    state "finland" {
        display-name "Финляндия"
        interface "fl"
        up-cmd "doas" "wg-quick" "up" "fl"
        down-cmd "doas" "wg-quick" "down" "fl"
    }
}

feature "daemons" enabled=true {
    daemon "picom" autostart=true {
        display-name "Picom Compositor"
        start-cmd "picom" "-b"
    }

    daemon "dunst" autostart=true {
        display-name "Dunst Notification Daemon"
        start-cmd "dunst"
    }
}

feature "keybinds" enabled=true {
    // Управление VPN (события передаются в VPN модуль)
    bind "ctrl+shift+f9" {
        vpn "off"
    }

    bind "ctrl+shift+f10" {
        vpn "warp"
    }

    bind "ctrl+shift+f11" {
        vpn "finland"
    }

    // Запуск внешних приложений
    bind "ctrl+shift+t" {
        run "alacritty"
    }

    // Управление демонами (on/off/toggle)
    bind "ctrl+shift+p" {
        daemon "picom" "toggle"
    }

    bind "ctrl+shift+d" {
        daemon "dunst" "toggle"
    }
}
