alt + c
	alacritty

alt + e
    alacritty --class yazi_sticky,yazi_sticky --command yazi

alt + space
	rofi -show combi

alt + p
	flameshot gui

alt + v
    copyq show

super + Escape
	pkill -USR1 -x sxhkd

super + alt + {q,r}
	bspc {quit,wm -r}

alt + {_,shift + }w
	bspc node -{c,k}

alt + m
	bspc desktop -l next

alt + g
	bspc node -s biggest.window

alt + {t,f,e}
	bspc node -t {tiled,floating,fullscreen}

alt + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# focus the next/previous window in the current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# focus the older or newer node in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

#alt + {_,shift + }{a,s,d,b,y,i,o,1-9,0}
#	bspc {desktop -f,node -d} '{a,s,d,b,y,i,o,1-9,10}'

alt + {_,shift + }{s,y,i,o,1-9,0}
	bspc {desktop -f,node -d} '{s,y,i,o,1-9,10}'

alt + {_,shift + }a
    ~/.config/bspwm/scripts/manage_window.sh AyuGramDesktop {second,main}

alt + {_,shift + }d
    ~/.config/bspwm/scripts/manage_window.sh discord {second,main}

alt + {_,shift + }b
    ~/.config/bspwm/scripts/manage_window.sh Brave-browser {main,second}

alt + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

alt + ctrl + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

XF86AudioPlay
    playerctl --player=spotify play-pause

XF86AudioNext
    playerctl --player=spotify next

XF86AudioPrev
    playerctl --player=spotify previous

XF86AudioRaiseVolume
	playerctl volume 0.02+ --player=spotify

XF86AudioLowerVolume
	playerctl volume 0.02- --player=spotify

XF86AudioMute
	playerctl play-pause --player=spotify
